# Exemplo de configuração local do DCAtoPLM.
# Copie para .env e substitua os placeholders pelos valores da estação.

# --- Vault DCA ---
DCA_ROOT=C:\VAULT_ROOT
DCA_VAULT_NAME=VAULT_NAME

# --- Importar GD / pasta temporária ---
DCA_IMPORTER_PATH=C:\Temp\ImportarGD\Importar GD.exe
DCA_TEMP_FOLDER=C:\Temp\DCAtoPLM

# --- Teamcenter: ambiente ativo (Teste ou Processo) ---
DCA_TC_ENV=Teste
DCA_TC_URL=http://<SERVIDOR_TEAMCENTER>:8080/tc
DCA_TC_USER=<USUARIO>
DCA_TC_PASSWORD=<SENHA>

# --- Tipos no ambiente de TESTE ---
DCA_TC_TEST_ORIGINAL_ITEM_TYPE=<ITEM_TYPE_DESENHO_ORIGINAL>
DCA_TC_TEST_ORIGINAL_REVISION_TYPE=<REVISION_TYPE_DESENHO_ORIGINAL>
DCA_TC_TEST_PROCESS_ITEM_TYPE=<ITEM_TYPE_PROCESSO>
DCA_TC_TEST_PROCESS_REVISION_TYPE=<REVISION_TYPE_PROCESSO>
DCA_TC_TEST_STANDARD_ITEM_TYPE=<ITEM_TYPE_NORMA_EXTERNA>
DCA_TC_TEST_STANDARD_REVISION_TYPE=<REVISION_TYPE_NORMA_EXTERNA>
DCA_TC_TEST_CLIENT_PROPERTY=<PROPRIEDADE_CLIENTE>
DCA_TC_TEST_CLIENT_VALUE=<VALOR_CLIENTE>

# --- Tipos no ambiente de PROCESSO ---
DCA_TC_PROCESS_ORIGINAL_ITEM_TYPE=<ITEM_TYPE_DESENHO_ORIGINAL>
DCA_TC_PROCESS_ORIGINAL_REVISION_TYPE=<REVISION_TYPE_DESENHO_ORIGINAL>
DCA_TC_PROCESS_PROCESS_ITEM_TYPE=<ITEM_TYPE_PROCESSO>
DCA_TC_PROCESS_PROCESS_REVISION_TYPE=<REVISION_TYPE_PROCESSO>
DCA_TC_PROCESS_STANDARD_ITEM_TYPE=<ITEM_TYPE_NORMA_EXTERNA>
DCA_TC_PROCESS_STANDARD_REVISION_TYPE=<REVISION_TYPE_NORMA_EXTERNA>
DCA_TC_PROCESS_CLIENT_PROPERTY=<PROPRIEDADE_CLIENTE>
DCA_TC_PROCESS_CLIENT_VALUE=<VALOR_CLIENTE>