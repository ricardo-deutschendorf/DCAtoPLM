# ============================================================
# DCAtoPLM - EXEMPLO DE CONFIGURACAO
# ============================================================
#
# Copie este arquivo com o nome ".env" e preencha os valores
# conforme o ambiente local.
#
# Este arquivo pode permanecer no repositorio porque nao deve
# conter senhas, usuarios, servidores ou caminhos internos reais.
#
# Nunca preencha credenciais diretamente no .env.example.
# ============================================================


# ============================================================
# AMBIENTE ATIVO
# ============================================================
#
# Valores permitidos:
#   Teste
#   Processo

DCA_TC_ENV=


# ============================================================
# VAULT DCA - SOLIDWORKS PDM
# ============================================================

# Caminho local da view do Vault.
DCA_ROOT=

# Nome da view local do Vault.
DCA_VAULT_NAME=

# Caminho da biblioteca Interop.EdmLib.dll.
DCA_PDM_LIB=

# Arquivo opcional de credenciais do Vault.
# Deixe vazio para utilizar LoginAuto com a sessao do Windows.
DCA_VAULT_CREDENTIAL=


# ============================================================
# IMPORTADOR E ARQUIVOS TEMPORARIOS
# ============================================================

# Caminho do executavel que contem as bibliotecas utilizadas
# para realizar a integracao com o Teamcenter.
DCA_IMPORTER_PATH=

# Pasta utilizada para preparar uma copia validada dos PDFs.
DCA_TEMP_FOLDER=


# ============================================================
# TEAMCENTER DE TESTE
# ============================================================

# URL do servidor do ambiente de Teste.
DCA_TC_TEST_URL=

# Usuario utilizado no ambiente de Teste.
DCA_TC_TEST_USER=

# Senha do ambiente de Teste.
#
# Recomenda-se deixar o valor vazio para que a senha seja
# solicitada no console durante a execucao.
DCA_TC_TEST_PASSWORD=


# ------------------------------------------------------------
# DCA Desenho Original - Teste
# ------------------------------------------------------------

# Nome tecnico do tipo de Item.
DCA_TC_TEST_ORIGINAL_ITEM_TYPE=

# Nome tecnico do tipo de revisao.
DCA_TC_TEST_ORIGINAL_REVISION_TYPE=

# Propriedade utilizada para identificar o cliente.
# Deixe vazia quando o tipo nao utilizar cliente.
DCA_TC_TEST_ORIGINAL_CLIENT_PROPERTY=

# Valor da propriedade de cliente.
# Deixe vazio quando o tipo nao utilizar cliente.
DCA_TC_TEST_ORIGINAL_CLIENT_VALUE=


# ------------------------------------------------------------
# DCA Processo - Teste
# ------------------------------------------------------------

# Nome tecnico do tipo de Item.
DCA_TC_TEST_PROCESS_ITEM_TYPE=

# Nome tecnico do tipo de revisao.
DCA_TC_TEST_PROCESS_REVISION_TYPE=

# Propriedade utilizada para identificar o cliente.
DCA_TC_TEST_PROCESS_CLIENT_PROPERTY=

# Valor da propriedade de cliente.
DCA_TC_TEST_PROCESS_CLIENT_VALUE=


# ------------------------------------------------------------
# DCA Norma Externa - Teste
# ------------------------------------------------------------

# Nome tecnico do tipo de Item.
DCA_TC_TEST_STANDARD_ITEM_TYPE=

# Nome tecnico do tipo de revisao.
DCA_TC_TEST_STANDARD_REVISION_TYPE=

# Propriedade utilizada para identificar o cliente.
# Deixe vazia quando o tipo nao utilizar cliente.
DCA_TC_TEST_STANDARD_CLIENT_PROPERTY=

# Valor da propriedade de cliente.
# Deixe vazio quando o tipo nao utilizar cliente.
DCA_TC_TEST_STANDARD_CLIENT_VALUE=


# ============================================================
# TEAMCENTER DE PROCESSO
# ============================================================
#
# Estas configuracoes somente serao utilizadas quando
# DCA_TC_ENV estiver configurado como Processo.

# URL do servidor do ambiente de Processo.
DCA_TC_PROCESS_URL=

# Usuario utilizado no ambiente de Processo.
DCA_TC_PROCESS_USER=

# Senha do ambiente de Processo.
#
# Recomenda-se deixar o valor vazio para que a senha seja
# solicitada no console durante a execucao.
DCA_TC_PROCESS_PASSWORD=


# ------------------------------------------------------------
# DCA Desenho Original - Processo
# ------------------------------------------------------------

# Nome tecnico do tipo de Item.
DCA_TC_PROCESS_ORIGINAL_ITEM_TYPE=

# Nome tecnico do tipo de revisao.
DCA_TC_PROCESS_ORIGINAL_REVISION_TYPE=

# Propriedade utilizada para identificar o cliente.
DCA_TC_PROCESS_ORIGINAL_CLIENT_PROPERTY=

# Valor da propriedade de cliente.
DCA_TC_PROCESS_ORIGINAL_CLIENT_VALUE=


# ------------------------------------------------------------
# DCA Processo - Processo
# ------------------------------------------------------------

# Nome tecnico do tipo de Item.
DCA_TC_PROCESS_PROCESS_ITEM_TYPE=

# Nome tecnico do tipo de revisao.
DCA_TC_PROCESS_PROCESS_REVISION_TYPE=

# Propriedade utilizada para identificar o cliente.
DCA_TC_PROCESS_PROCESS_CLIENT_PROPERTY=

# Valor da propriedade de cliente.
DCA_TC_PROCESS_PROCESS_CLIENT_VALUE=


# ------------------------------------------------------------
# DCA Norma Externa - Processo
# ------------------------------------------------------------

# Nome tecnico do tipo de Item.
DCA_TC_PROCESS_STANDARD_ITEM_TYPE=

# Nome tecnico do tipo de revisao.
DCA_TC_PROCESS_STANDARD_REVISION_TYPE=

# Propriedade utilizada para identificar o cliente.
DCA_TC_PROCESS_STANDARD_CLIENT_PROPERTY=

# Valor da propriedade de cliente.
DCA_TC_PROCESS_STANDARD_CLIENT_VALUE=


# ============================================================
# CONFIGURACOES COMPARTILHADAS DO TEAMCENTER
# ============================================================

# Revisao inicial utilizada no item_revision_id das Normas Externas.
#
# O valor precisa respeitar a Naming Rule configurada no
# Teamcenter para o tipo de revisao correspondente.
DCA_TC_STANDARD_INITIAL_REVISION=

# Empresa utilizada pelo metodo getItem durante a consulta de
# Items existentes para documentos do tipo DatasetOnly.
#
# Deixe vazio quando o ambiente nao exigir esse filtro.
DCA_TC_DATASET_COMPANY=

# Propriedades que devem ser enviadas em IntProps.
#
# Os nomes podem ser separados por:
#   ponto e virgula
#   virgula
#   barra vertical
#
# Utilize "none" quando nenhuma propriedade for inteira.
DCA_TC_INTEGER_PROPERTIES=


# ============================================================
# WORKFLOWS DO TEAMCENTER
# ============================================================

# Workflow iniciado quando o documento estiver Aprovado no PDM.
DCA_TC_APPROVED_WORKFLOW=

# Workflow iniciado quando o documento estiver Obsoleto no PDM.
DCA_TC_OBSOLETE_WORKFLOW=


# ============================================================
# CARTAO DA FICHA DE PROCESSO
# ============================================================

# Nome da variavel que contem a revisao completa do Processo.
#
# Exemplo:
#   Revision
DCA_PDM_VAR_PROCESS_REVISION=

# Nome da variavel que contem a descricao do Processo.
#
# Exemplo:
#   FP_Desc
DCA_PDM_VAR_PROCESS_DESCRIPTION=

# Nome da variavel que contem o aprovador no cartao do PDM.
#
# O valor encontrado sera enviado diretamente para a propriedade
# gd5AprovadorPDM da revisao de Processo no Teamcenter.
#
# Exemplo:
#   Aprovador
DCA_PDM_VAR_PROCESS_APPROVER=

# Nome da variavel que contem a data de aprovacao no cartao.
#
# O valor somente existe no banco do PDM quando a caixa associada
# ao campo de data estiver marcada no cartao.
#
# A data encontrada sera enviada diretamente para a propriedade
# gd5AprovadorPDMData da revisao de Processo no Teamcenter.
#
# Exemplo:
#   FP_DataAprov
DCA_PDM_VAR_PROCESS_APPROVAL_DATE=

# ============================================================
# CARTAO DO DOCUMENTO XXRE DIMENSIONAL
# ============================================================

# Nome da variavel que contem a revisao existente que recebera
# somente o Dataset.
DCA_PDM_VAR_DATASET_REVISION=


# ============================================================
# CARTAO DO DESENHO ORIGINAL
# ============================================================

# Nome da variavel que contem a revisao do Desenho Original.
DCA_PDM_VAR_ORIGINAL_REVISION=

# Nome da variavel que contem a descricao do Desenho Original.
DCA_PDM_VAR_ORIGINAL_DESCRIPTION=


# ============================================================
# CARTAO DA NORMA EXTERNA
# ============================================================

# Nomes das variaveis que podem conter a revisao da Norma Externa.
#
# Quando houver mais de uma variavel, separe os nomes com uma
# barra vertical. As variaveis serao testadas na ordem informada.
DCA_PDM_VAR_STANDARD_REVISION=

# Nome da variavel que contem a descricao da Norma Externa.
DCA_PDM_VAR_STANDARD_DESCRIPTION=

# ============================================================
# LOGS E RELATORIOS
# ============================================================
#
# Quando os valores permanecerem vazios, os arquivos serao
# criados nas pastas logs e reports da raiz do projeto.

# Pasta opcional para os logs de execucao.
DCA_LOG_FOLDER=

# Pasta opcional para os relatorios CSV.
DCA_REPORT_FOLDER=