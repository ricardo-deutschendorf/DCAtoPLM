# ============================================================
# DCAtoPLM - EXEMPLO DE CONFIGURACAO
# ============================================================
#
# Este arquivo contem somente exemplos seguros das configuracoes
# utilizadas pelo DCAtoPLM.
#
# Para configurar uma maquina:
#   1. copie este arquivo como .env;
#   2. substitua os valores entre < >;
#   3. mantenha o arquivo .env fora do repositorio;
#   4. nunca grave senhas ou caminhos internos neste exemplo.
#
# O arquivo .env.example pode ser enviado ao repositorio.
# O arquivo .env local nao deve ser enviado.
# ============================================================


# ============================================================
# AMBIENTE ATIVO
# ============================================================
#
# Valores permitidos:
#   Teste
#   Processo
#
# As configuracoes dos dois ambientes podem permanecer
# preenchidas, mas somente o ambiente selecionado sera utilizado.

DCA_TC_ENV=Teste


# ============================================================
# VAULT DCA - SOLIDWORKS PDM
# ============================================================

# Caminho local da view do Vault.
DCA_ROOT=<CAMINHO_DA_VIEW_DO_VAULT>

# Nome da view local do Vault.
DCA_VAULT_NAME=<NOME_DO_VAULT>

# Caminho completo da biblioteca Interop.EdmLib.dll.
DCA_PDM_LIB=<CAMINHO_DA_INTEROP_EDMLIB_DLL>

# Arquivo opcional de credenciais do Vault.
#
# Deixe vazio para utilizar LoginAuto com a sessao atual
# do Windows.
DCA_VAULT_CREDENTIAL=


# ============================================================
# IMPORTADOR E ARQUIVOS TEMPORARIOS
# ============================================================

# Origem de rede do Importar GD
DCA_IMPORTER_SOURCE=
# Pasta local utilizada pelo DCAtoPLM
DCA_IMPORTER_DESTINATION=

# Executavel local carregado como assembly
DCA_IMPORTER_PATH=

# Pasta utilizada para preparar uma copia validada dos PDFs.
DCA_TEMP_FOLDER=<CAMINHO_DA_PASTA_TEMPORARIA>


# ============================================================
# TEAMCENTER DE TESTE
# ============================================================

# URL completa do Teamcenter de Teste.
#
# Exemplo de formato:
# http://servidor-teste:8080/tc
DCA_TC_TEST_URL=<URL_DO_TEAMCENTER_DE_TESTE>

# Usuario utilizado na autenticacao.
DCA_TC_TEST_USER=<USUARIO_DO_TEAMCENTER_DE_TESTE>

# Senha opcional.
#
# Deixe vazia para solicitar a senha no console durante a
# execucao.
DCA_TC_TEST_PASSWORD=


# ------------------------------------------------------------
# DCA Desenho Original - Teste
# ------------------------------------------------------------

DCA_TC_TEST_ORIGINAL_ITEM_TYPE=<TIPO_DO_ITEM_DE_DESENHO_EM_TESTE>
DCA_TC_TEST_ORIGINAL_REVISION_TYPE=<TIPO_DA_REVISAO_DE_DESENHO_EM_TESTE>

# Propriedade e valor do cliente.
#
# Deixe ambos vazios quando o tipo nao utilizar cliente.
DCA_TC_TEST_ORIGINAL_CLIENT_PROPERTY=
DCA_TC_TEST_ORIGINAL_CLIENT_VALUE=


# ------------------------------------------------------------
# DCA Processo - Teste
# ------------------------------------------------------------

DCA_TC_TEST_PROCESS_ITEM_TYPE=<TIPO_DO_ITEM_DE_PROCESSO_EM_TESTE>
DCA_TC_TEST_PROCESS_REVISION_TYPE=<TIPO_DA_REVISAO_DE_PROCESSO_EM_TESTE>

DCA_TC_TEST_PROCESS_CLIENT_PROPERTY=<PROPRIEDADE_DO_CLIENTE_EM_TESTE>
DCA_TC_TEST_PROCESS_CLIENT_VALUE=<VALOR_DO_CLIENTE_EM_TESTE>


# ------------------------------------------------------------
# DCA Norma Externa - Teste
# ------------------------------------------------------------

DCA_TC_TEST_STANDARD_ITEM_TYPE=<TIPO_DO_ITEM_DE_NORMA_EM_TESTE>
DCA_TC_TEST_STANDARD_REVISION_TYPE=<TIPO_DA_REVISAO_DE_NORMA_EM_TESTE>

# Deixe ambos vazios quando o tipo nao utilizar cliente.
DCA_TC_TEST_STANDARD_CLIENT_PROPERTY=
DCA_TC_TEST_STANDARD_CLIENT_VALUE=

# ============================================================
# DCA NDT - AMBIENTE DE TESTE
# ============================================================

DCA_TC_TEST_NDT_ITEM_TYPE=DCA NDT
DCA_TC_TEST_NDT_REVISION_TYPE=DCA NDT Revision
DCA_TC_TEST_NDT_CLIENT_PROPERTY=
DCA_TC_TEST_NDT_CLIENT_VALUE=

# ============================================================
# TEAMCENTER DE PROCESSO
# ============================================================
#
# Estas configuracoes serao utilizadas somente quando:
#
# DCA_TC_ENV=Processo

# URL completa do Teamcenter de Processo.
#
# Exemplo de formato:
# http://servidor-processo:8080/tc
DCA_TC_PROCESS_URL=<URL_DO_TEAMCENTER_DE_PROCESSO>

# Usuario utilizado na autenticacao.
DCA_TC_PROCESS_USER=<USUARIO_DO_TEAMCENTER_DE_PROCESSO>

# Senha opcional.
#
# Deixe vazia para solicitar a senha no console durante a
# execucao.
DCA_TC_PROCESS_PASSWORD=


# ------------------------------------------------------------
# DCA Desenho Original - Processo
# ------------------------------------------------------------

DCA_TC_PROCESS_ORIGINAL_ITEM_TYPE=<TIPO_DO_ITEM_DE_DESENHO_EM_PROCESSO>
DCA_TC_PROCESS_ORIGINAL_REVISION_TYPE=<TIPO_DA_REVISAO_DE_DESENHO_EM_PROCESSO>

DCA_TC_PROCESS_ORIGINAL_CLIENT_PROPERTY=<PROPRIEDADE_DO_CLIENTE_EM_PROCESSO>
DCA_TC_PROCESS_ORIGINAL_CLIENT_VALUE=<VALOR_DO_CLIENTE_EM_PROCESSO>


# ------------------------------------------------------------
# DCA Processo - Processo
# ------------------------------------------------------------

DCA_TC_PROCESS_PROCESS_ITEM_TYPE=<TIPO_DO_ITEM_DE_PROCESSO_EM_PROCESSO>
DCA_TC_PROCESS_PROCESS_REVISION_TYPE=<TIPO_DA_REVISAO_DE_PROCESSO_EM_PROCESSO>

DCA_TC_PROCESS_PROCESS_CLIENT_PROPERTY=<PROPRIEDADE_DO_CLIENTE_EM_PROCESSO>
DCA_TC_PROCESS_PROCESS_CLIENT_VALUE=<VALOR_DO_CLIENTE_EM_PROCESSO>


# ------------------------------------------------------------
# DCA Norma Externa - Processo
# ------------------------------------------------------------

DCA_TC_PROCESS_STANDARD_ITEM_TYPE=<TIPO_DO_ITEM_DE_NORMA_EM_PROCESSO>
DCA_TC_PROCESS_STANDARD_REVISION_TYPE=<TIPO_DA_REVISAO_DE_NORMA_EM_PROCESSO>

DCA_TC_PROCESS_STANDARD_CLIENT_PROPERTY=<PROPRIEDADE_DO_CLIENTE_EM_PROCESSO>
DCA_TC_PROCESS_STANDARD_CLIENT_VALUE=<VALOR_DO_CLIENTE_EM_PROCESSO>

# ============================================================
# DCA NDT - AMBIENTE DE PROCESSO
# ============================================================

DCA_TC_PROCESS_NDT_ITEM_TYPE=DCA NDT
DCA_TC_PROCESS_NDT_REVISION_TYPE=DCA NDT Revision
DCA_TC_PROCESS_NDT_CLIENT_PROPERTY=
DCA_TC_PROCESS_NDT_CLIENT_VALUE=

# ============================================================
# CONFIGURACOES COMPARTILHADAS DO TEAMCENTER
# ============================================================

# Revisao inicial utilizada no item_revision_id das Normas
# Externas.
#
# O tipo de revisao deve aceitar o valor configurado abaixo.
# A revisao documental do PDF continua sendo utilizada como
# revisao do Dataset.
DCA_TC_STANDARD_INITIAL_REVISION=001

# Empresa utilizada pelo metodo getItem durante a consulta de
# Items existentes para documentos do tipo DatasetOnly.
#
# Deixe vazio se o ambiente nao exigir esse filtro.
DCA_TC_DATASET_COMPANY=<VALOR_DA_EMPRESA_PARA_DATASET_ONLY>

# Propriedades enviadas ao Teamcenter em IntProps.
#
# Use nomes separados por:
#   ponto e virgula;
#   virgula;
#   barra vertical.
#
# Use "none" quando nenhuma propriedade precisar ser inteira.
DCA_TC_INTEGER_PROPERTIES=gd5revinterna


# ============================================================
# WORKFLOWS DO TEAMCENTER
# ============================================================

# Workflow iniciado quando o documento estiver Aprovado no PDM.
DCA_TC_APPROVED_WORKFLOW=<NOME_DO_WORKFLOW_DE_APROVACAO>

# Workflow iniciado quando o documento estiver Obsoleto no PDM.
DCA_TC_OBSOLETE_WORKFLOW=<NOME_DO_WORKFLOW_DE_OBSOLESCENCIA>


# ============================================================
# CARTAO DA FICHA DE PROCESSO
# ============================================================

# Campo que armazena a revisao completa no cartao.
#
# Mais de um nome pode ser informado, separado por barra vertical
# ou ponto e virgula. O primeiro campo preenchido sera utilizado.
#
# Exemplos de valores do cartao:
#   AH-3
#   AH3
#   BA-4
#   BA4
DCA_PDM_VAR_PROCESS_REVISION=<CAMPO_DA_REVISAO_DE_PROCESSO>

# Campo que armazena a descricao utilizada como nome e descricao
# no Teamcenter.
DCA_PDM_VAR_PROCESS_DESCRIPTION=<CAMPO_DA_DESCRICAO_DE_PROCESSO>

# Campo que armazena o aprovador no cartao.
#
# O valor sera enviado para a propriedade gd5AprovadorPDM.
DCA_PDM_VAR_PROCESS_APPROVER=<CAMPO_DO_APROVADOR>

# Campo que armazena a data de aprovacao no cartao.
#
# O valor sera enviado para a propriedade gd5AprovadorPDMData.
DCA_PDM_VAR_PROCESS_APPROVAL_DATE=<CAMPO_DA_DATA_DE_APROVACAO>


# ============================================================
# CARTAO DO DOCUMENTO XXRE DIMENSIONAL
# ============================================================

# Revisao existente no Teamcenter que recebera somente o Dataset.
DCA_PDM_VAR_DATASET_REVISION=<CAMPO_DA_REVISAO_DO_XXRE>


# ============================================================
# CARTAO DO DESENHO ORIGINAL
# ============================================================

# Campo que armazena a revisao do desenho.
#
# Exemplos:
#   A
#   B
#   02
DCA_PDM_VAR_ORIGINAL_REVISION=<CAMPO_DA_REVISAO_DO_DESENHO>

# Campo que armazena a descricao utilizada como nome e descricao
# no Teamcenter.
DCA_PDM_VAR_ORIGINAL_DESCRIPTION=<CAMPO_DA_DESCRICAO_DO_DESENHO>


# ============================================================
# CARTAO DA NORMA EXTERNA
# ============================================================

# Campos que podem armazenar a revisao documental.
#
# Os nomes sao testados na ordem informada. O primeiro campo
# encontrado e preenchido sera utilizado.
#
# Use barra vertical ou ponto e virgula como separador.
DCA_PDM_VAR_STANDARD_REVISION=<CAMPO_1_DA_REVISAO>|<CAMPO_2_DA_REVISAO>

# Campo que armazena a descricao utilizada como nome e descricao
# no Teamcenter.
DCA_PDM_VAR_STANDARD_DESCRIPTION=<CAMPO_DA_DESCRICAO_DA_NORMA>


# ============================================================
# LOGS E RELATORIOS
# ============================================================
#
# Quando os valores permanecerem vazios:
#
#   logs:
#     serao criados na pasta logs da raiz do projeto;
#
#   relatorios:
#     serao criados na pasta reports da raiz do projeto.

DCA_LOG_FOLDER=
DCA_REPORT_FOLDER=

# Tipo técnico do Dataset utilizado para desenhos SLDDRW
DCA_TC_NDT_DRAWING_DATASET_TYPE=

# Ferramenta associada ao Dataset SLDDRW
DCA_TC_NDT_DRAWING_TOOL=

# Named Reference que recebe o arquivo SLDDRW
DCA_TC_NDT_DRAWING_REFERENCE=