# Local configuration template for DCAtoPLM
#
# Copy this file to ".env" and replace every placeholder.
# Never commit the real ".env" file.
# Never store real passwords, internal URLs, tokens, or credential files
# in the repository.

# ============================================================
# DCA vault - SolidWorks PDM
# ============================================================

# Local root containing the DCA vault view.
DCA_ROOT=<DCA_VAULT_ROOT>

# Exact SolidWorks PDM vault name.
DCA_VAULT_NAME=<PDM_VAULT_NAME>

# Full path to the SolidWorks PDM interop library.
DCA_PDM_LIB=<PATH_TO_INTEROP_EDMLIB_DLL>

# Optional protected credential file created with Export-Clixml.
# Leave empty to use LoginAuto with the current Windows/PDM session.
DCA_VAULT_CREDENTIAL=

# ============================================================
# Teamcenter importer and temporary folder
# ============================================================

# Full path to the compatible Teamcenter integration executable.
DCA_IMPORTER_PATH=<PATH_TO_TEAMCENTER_IMPORTER_EXE>

# Local folder used to prepare PDFs before Teamcenter import.
DCA_TEMP_FOLDER=<TEMPORARY_PDF_FOLDER>

# ============================================================
# Active Teamcenter environment
# ============================================================

# Allowed values:
# Teste
# Processo
DCA_TC_ENV=Teste

# ============================================================
# Teamcenter test environment
# ============================================================

DCA_TC_TEST_URL=<TEAMCENTER_TEST_URL>
DCA_TC_TEST_USER=<TEAMCENTER_TEST_USER>
DCA_TC_TEST_PASSWORD=<TEAMCENTER_TEST_PASSWORD>

# DCA Original Drawing
DCA_TC_TEST_ORIGINAL_ITEM_TYPE=<TEST_ORIGINAL_ITEM_TYPE>
DCA_TC_TEST_ORIGINAL_REVISION_TYPE=<TEST_ORIGINAL_REVISION_TYPE>
DCA_TC_TEST_ORIGINAL_CLIENT_PROPERTY=<TEST_ORIGINAL_CLIENT_PROPERTY>
DCA_TC_TEST_ORIGINAL_CLIENT_VALUE=<TEST_ORIGINAL_CLIENT_VALUE>

# DCA Process
DCA_TC_TEST_PROCESS_ITEM_TYPE=<TEST_PROCESS_ITEM_TYPE>
DCA_TC_TEST_PROCESS_REVISION_TYPE=<TEST_PROCESS_REVISION_TYPE>
DCA_TC_TEST_PROCESS_CLIENT_PROPERTY=<TEST_PROCESS_CLIENT_PROPERTY>
DCA_TC_TEST_PROCESS_CLIENT_VALUE=<TEST_PROCESS_CLIENT_VALUE>

# DCA External Standard
DCA_TC_TEST_STANDARD_ITEM_TYPE=<TEST_STANDARD_ITEM_TYPE>
DCA_TC_TEST_STANDARD_REVISION_TYPE=<TEST_STANDARD_REVISION_TYPE>
DCA_TC_TEST_STANDARD_CLIENT_PROPERTY=<TEST_STANDARD_CLIENT_PROPERTY>
DCA_TC_TEST_STANDARD_CLIENT_VALUE=<TEST_STANDARD_CLIENT_VALUE>

# ============================================================
# Teamcenter production/process environment
# ============================================================

DCA_TC_PROCESS_URL=<TEAMCENTER_PROCESS_URL>
DCA_TC_PROCESS_USER=<TEAMCENTER_PROCESS_USER>
DCA_TC_PROCESS_PASSWORD=<TEAMCENTER_PROCESS_PASSWORD>

# DCA Original Drawing
DCA_TC_PROCESS_ORIGINAL_ITEM_TYPE=<PROCESS_ORIGINAL_ITEM_TYPE>
DCA_TC_PROCESS_ORIGINAL_REVISION_TYPE=<PROCESS_ORIGINAL_REVISION_TYPE>
DCA_TC_PROCESS_ORIGINAL_CLIENT_PROPERTY=<PROCESS_ORIGINAL_CLIENT_PROPERTY>
DCA_TC_PROCESS_ORIGINAL_CLIENT_VALUE=<PROCESS_ORIGINAL_CLIENT_VALUE>

# DCA Process
DCA_TC_PROCESS_PROCESS_ITEM_TYPE=<PROCESS_DOCUMENT_ITEM_TYPE>
DCA_TC_PROCESS_PROCESS_REVISION_TYPE=<PROCESS_DOCUMENT_REVISION_TYPE>
DCA_TC_PROCESS_PROCESS_CLIENT_PROPERTY=<PROCESS_DOCUMENT_CLIENT_PROPERTY>
DCA_TC_PROCESS_PROCESS_CLIENT_VALUE=<PROCESS_DOCUMENT_CLIENT_VALUE>

# DCA External Standard
DCA_TC_PROCESS_STANDARD_ITEM_TYPE=<PROCESS_STANDARD_ITEM_TYPE>
DCA_TC_PROCESS_STANDARD_REVISION_TYPE=<PROCESS_STANDARD_REVISION_TYPE>
DCA_TC_PROCESS_STANDARD_CLIENT_PROPERTY=<PROCESS_STANDARD_CLIENT_PROPERTY>
DCA_TC_PROCESS_STANDARD_CLIENT_VALUE=<PROCESS_STANDARD_CLIENT_VALUE>

# ============================================================
# Teamcenter workflow templates
# ============================================================

# Workflow started when the PDM file state is "Aprovado".
DCA_TC_APPROVED_WORKFLOW=<APPROVED_WORKFLOW_TEMPLATE>

# Workflow started when the PDM file state is "Obsoleto".
DCA_TC_OBSOLETE_WORKFLOW=<OBSOLETE_WORKFLOW_TEMPLATE>