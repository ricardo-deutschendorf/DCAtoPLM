# ============================================================
# Vault DCA - SOLIDWORKS PDM
# ============================================================

# Caminho local da view do Vault.
DCA_ROOT=<CAMINHO_LOCAL_DO_VAULT>

# Nome da view do Vault.
DCA_VAULT_NAME=<NOME_DO_VAULT>

# Caminho da biblioteca Interop.EdmLib.dll.
DCA_PDM_LIB=<CAMINHO_DA_INTEROP_EDMLIB_DLL>

# Arquivo opcional de credenciais do Vault.
# Deixe vazio para utilizar LoginAuto.
DCA_VAULT_CREDENTIAL=


# ============================================================
# Importador e arquivos temporarios
# ============================================================

# Caminho do executavel utilizado para integrar com o Teamcenter.
DCA_IMPORTER_PATH=<CAMINHO_DO_IMPORTADOR>

# Pasta temporaria utilizada para preparar os PDFs.
DCA_TEMP_FOLDER=<CAMINHO_DA_PASTA_TEMPORARIA>


# ============================================================
# Ambiente ativo
# ============================================================

# Valores permitidos:
# servidor_teste
# servidor_processo
DCA_TC_ENV=servidor_teste


# ============================================================
# Teamcenter de TESTE
# ============================================================

DCA_TC_TEST_URL=<URL_DO_TEAMCENTER_DE_TESTE>
DCA_TC_TEST_USER=<USUARIO_DE_TESTE>
DCA_TC_TEST_PASSWORD=<SENHA_DE_TESTE>


# ------------------------------------------------------------
# DCA Desenho Original - Teste
# ------------------------------------------------------------

DCA_TC_TEST_ORIGINAL_ITEM_TYPE=<TIPO_DO_ITEM_DE_DESENHO>
DCA_TC_TEST_ORIGINAL_REVISION_TYPE=<TIPO_DA_REVISAO_DE_DESENHO>

# Propriedade e valor opcionais aplicados ao Item.
DCA_TC_TEST_ORIGINAL_CLIENT_PROPERTY=
DCA_TC_TEST_ORIGINAL_CLIENT_VALUE=


# ------------------------------------------------------------
# DCA Processo - Teste
# ------------------------------------------------------------

DCA_TC_TEST_PROCESS_ITEM_TYPE=<TIPO_DO_ITEM_DE_PROCESSO>
DCA_TC_TEST_PROCESS_REVISION_TYPE=<TIPO_DA_REVISAO_DE_PROCESSO>

DCA_TC_TEST_PROCESS_CLIENT_PROPERTY=<PROPRIEDADE_DO_CLIENTE>
DCA_TC_TEST_PROCESS_CLIENT_VALUE=<VALOR_DO_CLIENTE>


# ------------------------------------------------------------
# DCA Norma Externa - Teste
# ------------------------------------------------------------

DCA_TC_TEST_STANDARD_ITEM_TYPE=<TIPO_DO_ITEM_DE_NORMA>
DCA_TC_TEST_STANDARD_REVISION_TYPE=<TIPO_DA_REVISAO_DE_NORMA>

DCA_TC_TEST_STANDARD_CLIENT_PROPERTY=
DCA_TC_TEST_STANDARD_CLIENT_VALUE=


# ============================================================
# Teamcenter de PROCESSO
# ============================================================

DCA_TC_PROCESS_URL=<URL_DO_TEAMCENTER_DE_PROCESSO>
DCA_TC_PROCESS_USER=<USUARIO_DE_PROCESSO>
DCA_TC_PROCESS_PASSWORD=<SENHA_DE_PROCESSO>


# ------------------------------------------------------------
# DCA Desenho Original - Processo
# ------------------------------------------------------------

DCA_TC_PROCESS_ORIGINAL_ITEM_TYPE=<TIPO_DO_ITEM_DE_DESENHO>
DCA_TC_PROCESS_ORIGINAL_REVISION_TYPE=<TIPO_DA_REVISAO_DE_DESENHO>

DCA_TC_PROCESS_ORIGINAL_CLIENT_PROPERTY=<PROPRIEDADE_DO_CLIENTE>
DCA_TC_PROCESS_ORIGINAL_CLIENT_VALUE=<VALOR_DO_CLIENTE>


# ------------------------------------------------------------
# DCA Processo - Processo
# ------------------------------------------------------------

DCA_TC_PROCESS_PROCESS_ITEM_TYPE=<TIPO_DO_ITEM_DE_PROCESSO>
DCA_TC_PROCESS_PROCESS_REVISION_TYPE=<TIPO_DA_REVISAO_DE_PROCESSO>

DCA_TC_PROCESS_PROCESS_CLIENT_PROPERTY=<PROPRIEDADE_DO_CLIENTE>
DCA_TC_PROCESS_PROCESS_CLIENT_VALUE=<VALOR_DO_CLIENTE>


# ------------------------------------------------------------
# DCA Norma Externa - Processo
# ------------------------------------------------------------

DCA_TC_PROCESS_STANDARD_ITEM_TYPE=<TIPO_DO_ITEM_DE_NORMA>
DCA_TC_PROCESS_STANDARD_REVISION_TYPE=<TIPO_DA_REVISAO_DE_NORMA>

DCA_TC_PROCESS_STANDARD_CLIENT_PROPERTY=<PROPRIEDADE_DO_CLIENTE>
DCA_TC_PROCESS_STANDARD_CLIENT_VALUE=<VALOR_DO_CLIENTE>


# ============================================================
# Workflows do Teamcenter
# ============================================================

DCA_TC_APPROVED_WORKFLOW=<NOME_DO_WORKFLOW_DE_APROVACAO>
DCA_TC_OBSOLETE_WORKFLOW=<NOME_DO_WORKFLOW_DE_OBSOLESCENCIA>


# ============================================================
# Propriedades inteiras do Teamcenter
# ============================================================

# Separe varios nomes por |, ; ou virgula.
# Use "none" caso nenhuma propriedade deva ser inteira.
DCA_TC_INTEGER_PROPERTIES=<PROPRIEDADES_INTEIRAS>


# ============================================================
# Cartao da Ficha de Processo
# ============================================================

DCA_PDM_VAR_PROCESS_REVISION=<VARIAVEL_DE_REVISAO_DO_PROCESSO>
DCA_PDM_VAR_PROCESS_DESCRIPTION=<VARIAVEL_DE_DESCRICAO_DO_PROCESSO>


# ============================================================
# Cartao do Desenho Original
# ============================================================

DCA_PDM_VAR_ORIGINAL_REVISION=<VARIAVEL_DE_REVISAO_DO_DESENHO>
DCA_PDM_VAR_ORIGINAL_DESCRIPTION=<VARIAVEL_DE_DESCRICAO_DO_DESENHO>


# ============================================================
# Cartao da Norma Externa
# ============================================================

# Para testar mais de uma variável, separe por |.
DCA_PDM_VAR_STANDARD_REVISION=<VARIAVEL_DE_REVISAO_DA_NORMA>

DCA_PDM_VAR_STANDARD_DESCRIPTION=<VARIAVEL_DE_DESCRICAO_DA_NORMA>


# ============================================================
# Diagnostico do cartao PDM
# ============================================================

# true  = lista as variaveis encontradas no cartao
# false = funcionamento normal
DCA_PDM_DISCOVER_CARD_VARIABLES=false