# ============================================================
# DCAtoPLM - EXEMPLO DE CONFIGURACAO
# ============================================================
# Copie este arquivo como .env e substitua os valores de exemplo.
# Nao inclua senhas, usuarios reais, servidores internos ou caminhos
# confidenciais neste arquivo versionado.
# ============================================================

# Ambiente ativo: Teste ou Processo.
DCA_TC_ENV=Teste

# ============================================================
# VAULT DCA - SOLIDWORKS PDM
# ============================================================
DCA_ROOT=C:\CAMINHO\DA\VIEW
DCA_VAULT_NAME=NOME_DO_VAULT
DCA_PDM_LIB=C:\CAMINHO\Interop.EdmLib.dll
# Vazio usa LoginAuto com a sessao do Windows.
DCA_VAULT_CREDENTIAL=

# ============================================================
# IMPORTADOR E ARQUIVOS TEMPORARIOS
# ============================================================
DCA_IMPORTER_SOURCE=\\SERVIDOR\COMPARTILHAMENTO\ImportarGD
DCA_IMPORTER_DESTINATION=C:\Temp\ImportarGD
DCA_IMPORTER_PATH=C:\Temp\ImportarGD\Importar GD.exe
DCA_TEMP_FOLDER=C:\Temp\DCAtoPLM

# ============================================================
# TEAMCENTER DE TESTE
# ============================================================
DCA_TC_TEST_URL=http://SERVIDOR_TESTE:8080/tc
DCA_TC_TEST_USER=USUARIO_TESTE
DCA_TC_TEST_PASSWORD=

DCA_TC_TEST_ORIGINAL_ITEM_TYPE=TIPO_ITEM_DESENHO
DCA_TC_TEST_ORIGINAL_REVISION_TYPE=TIPO_REVISAO_DESENHO
DCA_TC_TEST_ORIGINAL_CLIENT_PROPERTY=
DCA_TC_TEST_ORIGINAL_CLIENT_VALUE=

DCA_TC_TEST_PROCESS_ITEM_TYPE=TIPO_ITEM_PROCESSO
DCA_TC_TEST_PROCESS_REVISION_TYPE=TIPO_REVISAO_PROCESSO
DCA_TC_TEST_PROCESS_CLIENT_PROPERTY=PROPRIEDADE_CLIENTE
DCA_TC_TEST_PROCESS_CLIENT_VALUE=CLIENTE_TESTE

DCA_TC_TEST_STANDARD_ITEM_TYPE=TIPO_ITEM_NORMA
DCA_TC_TEST_STANDARD_REVISION_TYPE=TIPO_REVISAO_NORMA
DCA_TC_TEST_STANDARD_CLIENT_PROPERTY=
DCA_TC_TEST_STANDARD_CLIENT_VALUE=

DCA_TC_TEST_NDT_ITEM_TYPE=TIPO_ITEM_NDT
DCA_TC_TEST_NDT_REVISION_TYPE=TIPO_REVISAO_NDT
DCA_TC_TEST_NDT_CLIENT_PROPERTY=
DCA_TC_TEST_NDT_CLIENT_VALUE=

# ============================================================
# TEAMCENTER DE PROCESSO
# ============================================================
DCA_TC_PROCESS_URL=http://SERVIDOR_PROCESSO:8080/tc
DCA_TC_PROCESS_USER=USUARIO_PROCESSO
DCA_TC_PROCESS_PASSWORD=

DCA_TC_PROCESS_ORIGINAL_ITEM_TYPE=TIPO_ITEM_DESENHO
DCA_TC_PROCESS_ORIGINAL_REVISION_TYPE=TIPO_REVISAO_DESENHO
DCA_TC_PROCESS_ORIGINAL_CLIENT_PROPERTY=PROPRIEDADE_CLIENTE
DCA_TC_PROCESS_ORIGINAL_CLIENT_VALUE=CLIENTE_PROCESSO

DCA_TC_PROCESS_PROCESS_ITEM_TYPE=TIPO_ITEM_PROCESSO
DCA_TC_PROCESS_PROCESS_REVISION_TYPE=TIPO_REVISAO_PROCESSO
DCA_TC_PROCESS_PROCESS_CLIENT_PROPERTY=PROPRIEDADE_CLIENTE
DCA_TC_PROCESS_PROCESS_CLIENT_VALUE=CLIENTE_PROCESSO

DCA_TC_PROCESS_STANDARD_ITEM_TYPE=TIPO_ITEM_NORMA
DCA_TC_PROCESS_STANDARD_REVISION_TYPE=TIPO_REVISAO_NORMA
DCA_TC_PROCESS_STANDARD_CLIENT_PROPERTY=PROPRIEDADE_CLIENTE
DCA_TC_PROCESS_STANDARD_CLIENT_VALUE=CLIENTE_PROCESSO

DCA_TC_PROCESS_NDT_ITEM_TYPE=TIPO_ITEM_NDT
DCA_TC_PROCESS_NDT_REVISION_TYPE=TIPO_REVISAO_NDT
DCA_TC_PROCESS_NDT_CLIENT_PROPERTY=
DCA_TC_PROCESS_NDT_CLIENT_VALUE=

# ============================================================
# CONFIGURACOES COMPARTILHADAS DO TEAMCENTER
# ============================================================
DCA_TC_STANDARD_INITIAL_REVISION=001
DCA_TC_DATASET_COMPANY=CLIENTE_DATASET
DCA_TC_INTEGER_PROPERTIES=PROPRIEDADE_INTEIRA

# ============================================================
# WORKFLOWS DO TEAMCENTER
# ============================================================
DCA_TC_APPROVED_WORKFLOW=NOME_WORKFLOW_APROVADO
DCA_TC_OBSOLETE_WORKFLOW=NOME_WORKFLOW_OBSOLETO

# ============================================================
# VARIAVEIS DOS CARTOES DO PDM
# ============================================================
DCA_PDM_VAR_PROCESS_REVISION=REVISAO_PROCESSO
DCA_PDM_VAR_PROCESS_DESCRIPTION=DESCRICAO_PROCESSO|DESCRICAO_ALTERNATIVA
DCA_PDM_VAR_PROCESS_APPROVER=APROVADOR_PROCESSO
DCA_PDM_VAR_PROCESS_APPROVAL_DATE=DATA_APROVACAO_PROCESSO

DCA_PDM_VAR_DATASET_REVISION=REVISAO_DATASET

DCA_PDM_VAR_ORIGINAL_REVISION=REVISAO_DESENHO
DCA_PDM_VAR_ORIGINAL_DESCRIPTION=DESCRICAO_DESENHO

DCA_PDM_VAR_STANDARD_REVISION=REVISAO_NORMA|REVISAO_NORMA_ALTERNATIVA
DCA_PDM_VAR_STANDARD_DESCRIPTION=DESCRICAO_NORMA

DCA_PDM_VAR_NDT_APPROVER=APROVADOR_NDT
DCA_PDM_VAR_NDT_APPROVAL_DATE=DATA_APROVACAO_NDT

# ============================================================
# DATASET DO DESENHO NDT
# ============================================================
DCA_TC_NDT_DRAWING_DATASET_TYPE=TIPO_DATASET_NDT
DCA_TC_NDT_DRAWING_TOOL=FERRAMENTA_DATASET_NDT
DCA_TC_NDT_DRAWING_REFERENCE=REFERENCIA_DATASET_NDT
